# ====================
# Unity
# ====================

# Временные файлы
Temp/
*.tmp
*.temp
FSTimeGet-*

# Сгенерированные и кэш
Library/
Build/
Builds/
MemoryCaptures/
Recordings/

# Asset Store (новые пакеты скачиваются в Library)
[Aa]ssets/[Aa]sset[Ss]tore[Tt]ools/
[Aa]ssets/PluginStore/

# Visual Studio / VS Code (создаёт Unity при генерации .csproj)
.vs/
.vscode/
.idea/

# Autogenerated CRNs
[Aa]ssets/[Aa]ssetsGenerator.cache
[Aa]ssets/aso_settings/

# NuGet
[Aa]ssets/[Pp]ackages/
nuget.exe

# ====================
# Visual Studio / Rider
# ====================

## User-specific files
*.suo
*.user
*.userosscache
*.sln.docstates

## Build results
[Dd]ebug/
[Dd]ebugPublic/
[Rr]elease/
[Rr]eleases/
x64/
x86/
bld/
[Bb]in/
[Oo]bj/
[Ll]og/
[Bb]uild/

## Visual Studio cache files
*.rsuser
*.vssscc
*.vspscc
.vs/
*.cache

## Rider
.idea/
*.sln.iml

# ====================
# ОС
# ====================

# Windows
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/

# macOS
.DS_Store

# Linux
*~

# Логи Unity (обязательно для вашей текущей ситуации)
Logs/

# Метаданные пакетов и кэши Package Manager (частая причина конфликтов)
Packages/manifest.lock
Packages/packages-lock.json

# Кэш импорта Unity (может быть большим и меняться при открытии проекта на разных машинах)
Library/metadata/
Library/cache/

# Артефакты сборки Unity, которые могут дублировать папки Build/
*.apk
*.aab
*.unitypackage
*.exe
*.dll
*.so
*.a
*.lib
*.pdb
*.mdb
*.db

# Временные файлы редактора и автосохранения
*.bak
*.swp

